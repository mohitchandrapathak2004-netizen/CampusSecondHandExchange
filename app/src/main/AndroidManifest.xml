<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permissions for accessing device gallery -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_campus_exchange_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_campus_exchange_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusSecondHandExchange">

        <!-- Splash Activity set as the Launcher (Entry Point) -->
        <activity
            android:name=".splash"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".login"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".register"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".home"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".product_details"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".add_listing"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".my_listings"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Profile"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>